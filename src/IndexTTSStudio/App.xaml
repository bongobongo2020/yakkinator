<Application x:Class="IndexTTSStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:IndexTTSStudio.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter" />
            <converters:BoolToVisConverter x:Key="BoolToVisConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:EmotionModeVisConverter x:Key="EmotionModeVisConverter" />
            <converters:NullToVisConverter x:Key="NullToVisConverter" />
            <converters:GenerateButtonTextConverter x:Key="GenerateButtonTextConverter" />
            <converters:PlayButtonTextConverter x:Key="PlayButtonTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
