<Page x:Class="IndexTTSStudio.Views.Pages.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Setup">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,4,8,4" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="First-Time Setup" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock Text="Yakkinator will download and configure everything automatically."
                       Opacity="0.6" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />

            <ui:CardExpander Header="Prerequisites" IsExpanded="True" Margin="0,0,0,4"
                             Background="{StaticResource RetroCard}"
                             BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="2,1,2,2">
                    <Run FontWeight="SemiBold">Required:</Run>
                    <LineBreak/>
                    <Run>• Git (</Run><Hyperlink NavigateUri="https://git-scm.com">git-scm.com</Hyperlink><Run>)</Run>
                    <LineBreak/>
                    <Run>• NVIDIA GPU with CUDA 12.8+ drivers</Run>
                    <LineBreak/>
                    <Run>• ~5 GB free disk space for models</Run>
                </TextBlock>
            </ui:CardExpander>

            <ui:CardExpander Header="What will be installed" Margin="0,0,0,4"
                             Background="{StaticResource RetroCard}"
                             BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="2,1,2,2">
                    <Run>1. uv (Python package manager)</Run><LineBreak/>
                    <Run>2. IndexTTS-2 repository + Python dependencies</Run><LineBreak/>
                    <Run>3. IndexTTS-2 model checkpoints (~2-4 GB from HuggingFace)</Run>
                </TextBlock>
            </ui:CardExpander>

            <ui:Card Margin="0,0,0,4" Padding="8,6,8,6"
                     Background="{StaticResource RetroCard}"
                     BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding Progress}" Height="4" Margin="0,0,0,5"
                                 IsIndeterminate="{Binding IsRunning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Begin Setup"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Command="{Binding RunSetupCommand}"
                                   Style="{StaticResource BounceButton}"
                                   IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                   Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVisConverter}}"
                                   Margin="0,0,6,0" />
                        <ui:Badge Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisConverter}}"
                                  Appearance="Success" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="Setup Complete" />
                        </ui:Badge>
                        <ui:Button Content="Re-download Models"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Command="{Binding RedownloadModelsCommand}"
                                   Style="{StaticResource BounceButton}"
                                   IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                   Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Title="Setup Error"
                        Message="{Binding ErrorText}"
                        IsOpen="{Binding HasError}"
                        Severity="Error"
                        Margin="0,0,0,6" />

            <ui:CardExpander Header="Setup Log"
                             Background="{StaticResource RetroCard}"
                             BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                <TextBox Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="150"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </ui:CardExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
