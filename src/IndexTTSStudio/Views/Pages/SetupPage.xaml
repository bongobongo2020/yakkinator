<Page x:Class="IndexTTSStudio.Views.Pages.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="True"
      Title="Setup">

    <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,4,8,4" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Setup" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock Text="Engines that still need installing are listed first. Installed ones are folded away; open one to reinstall it."
                       Opacity="0.6" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />

            <!-- Progress of whatever is installing, always in view -->
            <ui:Card Margin="0,0,0,4" Padding="8,6,8,6"
                     Background="{StaticResource RetroCard}"
                     BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding Progress}" Height="4" IsIndeterminate="{Binding IsRunning}" />
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Title="Setup Error"
                        Message="{Binding ErrorText}"
                        IsOpen="{Binding HasError}"
                        Severity="Error"
                        Margin="0,0,0,4" />

            <!-- Engines: SetupPage.xaml.cs puts the ones that aren't installed first and expands only those -->
            <StackPanel x:Name="EngineList">

                <!-- IndexTTS-2 -->
                <ui:CardExpander x:Name="IndexTtsCard" Margin="0,0,0,4"
                                 Background="{StaticResource RetroCard}"
                                 BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IndexTTS-2" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Badge Appearance="Success" VerticalAlignment="Center"
                                      Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Installed" FontSize="11" />
                            </ui:Badge>
                            <ui:Badge Appearance="Caution" VerticalAlignment="Center"
                                      Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBlock Text="Needs setup" FontSize="11" />
                            </ui:Badge>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5">
                            <Run>The main engine: clones a voice sample, with emotion control. Installs uv, the IndexTTS-2 repository and its Python dependencies, and the model checkpoints (~2-4 GB from Hugging Face).</Run>
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Needs:</Run>
                            <Run> Git (</Run><Hyperlink NavigateUri="https://git-scm.com">git-scm.com</Hyperlink><Run>), an NVIDIA GPU with CUDA 12.8+ drivers, ~5 GB free disk space.</Run>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Begin Setup"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Command="{Binding RunSetupCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVisConverter}}"
                                       Margin="0,0,6,0" />
                            <ui:Button Content="Re-download Models"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding RedownloadModelsCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Echo-TTS -->
                <ui:CardExpander x:Name="EchoCard" Margin="0,0,0,4"
                                 Background="{StaticResource RetroCard}"
                                 BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Echo-TTS" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Badge Appearance="Success" VerticalAlignment="Center"
                                      Visibility="{Binding IsEchoInstalled, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Installed" FontSize="11" />
                            </ui:Badge>
                            <ui:Badge Appearance="Caution" VerticalAlignment="Center"
                                      Visibility="{Binding IsEchoInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBlock Text="Not installed · optional" FontSize="11" />
                            </ui:Badge>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5">
                            <Run>A fast engine you can pick on the Generate page: </Run>
                            <Hyperlink NavigateUri="https://github.com/Cirius0310/echo-tts-cpp">Echo-TTS C++</Hyperlink>
                            <Run>. Downloads a portable runtime (~1.7 GB, CUDA libraries included) and the Q8 model (~5 GB). Needs an NVIDIA GPU. Model weights are licensed CC-BY-NC-SA 4.0 (non-commercial).</Run>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Install Echo-TTS"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallEchoCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsEchoInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                            <ui:Button Content="Reinstall Echo-TTS"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallEchoCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsEchoInstalled, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Indic-Speak -->
                <ui:CardExpander x:Name="IndicCard" Margin="0,0,0,4"
                                 Background="{StaticResource RetroCard}"
                                 BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Indic-Speak" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Badge Appearance="Success" VerticalAlignment="Center"
                                      Visibility="{Binding IsIndicInstalled, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Installed" FontSize="11" />
                            </ui:Badge>
                            <ui:Badge Appearance="Caution" VerticalAlignment="Center"
                                      Visibility="{Binding IsIndicInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBlock Text="Not installed · optional" FontSize="11" />
                            </ui:Badge>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5">
                            <Run>An engine for 22 Indian languages plus Indian English: </Run>
                            <Hyperlink NavigateUri="https://huggingface.co/bodhan-ai/indic-speak">Indic-Speak</Hyperlink>
                            <Run>. 95 built-in voices with natural Hinglish-style code-switching (no voice cloning). Downloads PyTorch (~2.5 GB) and the model (~6.6 GB). Needs an NVIDIA GPU with ~10 GB VRAM. Licensed under the Indic Open Model License.</Run>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5"
                                   Visibility="{Binding IsIndicInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Run FontWeight="SemiBold">The model is gated.</Run>
                            <Run>First </Run><Hyperlink NavigateUri="https://huggingface.co/bodhan-ai/indic-speak">accept its license on Hugging Face</Hyperlink><Run>, then </Run>
                            <Hyperlink NavigateUri="https://huggingface.co/settings/tokens">create a Read token</Hyperlink>
                            <Run> and paste it below. It's used for this download only and isn't saved. (Leave it empty if you've already run "hf auth login".)</Run>
                        </TextBlock>
                        <ui:PasswordBox
                                        PlaceholderText="hf_... (Hugging Face read token)"
                                        Password="{Binding HfToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                        Margin="0,0,0,5" MaxWidth="360" HorizontalAlignment="Left" MinWidth="300" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Install Indic-Speak"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallIndicCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsIndicInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                            <ui:Button Content="Reinstall Indic-Speak"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallIndicCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsIndicInstalled, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Voice designer -->
                <ui:CardExpander x:Name="VoiceDesignCard" Margin="0,0,0,4"
                                 Background="{StaticResource RetroCard}"
                                 BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Voice Designer · Qwen3-TTS" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Badge Appearance="Success" VerticalAlignment="Center"
                                      Visibility="{Binding IsVoiceDesignInstalled, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Installed" FontSize="11" />
                            </ui:Badge>
                            <ui:Badge Appearance="Caution" VerticalAlignment="Center"
                                      Visibility="{Binding IsVoiceDesignInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBlock Text="Not installed · optional" FontSize="11" />
                            </ui:Badge>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5">
                            <Run>Create original voices from a description ("a raspy middle-aged man with a warm, unhurried voice") with </Run>
                            <Hyperlink NavigateUri="https://huggingface.co/Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign">Qwen3-TTS VoiceDesign</Hyperlink>
                            <Run>, then save them to the Voice Library for Echo-TTS and IndexTTS-2 to clone. Downloads PyTorch (~2.5 GB) and the model (~4.5 GB). Needs an NVIDIA GPU with ~6 GB free VRAM; the other engines are unloaded while you design. Licensed under Apache-2.0.</Run>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Install Voice Designer"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallVoiceDesignCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsVoiceDesignInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                            <ui:Button Content="Reinstall Voice Designer"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallVoiceDesignCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsVoiceDesignInstalled, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Voice Designer · MOSS (Irish accents) -->
                <ui:CardExpander x:Name="MossDesignCard" Margin="0,0,0,4"
                                 Background="{StaticResource RetroCard}"
                                 BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Voice Designer · MOSS (Irish accents)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Badge Appearance="Success" VerticalAlignment="Center"
                                      Visibility="{Binding IsMossDesignInstalled, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Installed" FontSize="11" />
                            </ui:Badge>
                            <ui:Badge Appearance="Caution" VerticalAlignment="Center"
                                      Visibility="{Binding IsMossDesignInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBlock Text="Not installed · optional" FontSize="11" />
                            </ui:Badge>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5">
                            <Run>A second voice designer: </Run>
                            <Hyperlink NavigateUri="https://huggingface.co/OpenMOSS-Team/MOSS-VoiceGenerator">MOSS-VoiceGenerator</Hyperlink>
                            <Run>. In Yakkinator's accent test it was the only designer that produces Irish accents, and it is good at Scottish and British ones. English and Chinese. Downloads PyTorch (~2.5 GB), the model (~4.2 GB) and its audio tokenizer (~7.1 GB). Needs an NVIDIA GPU with ~8 GB free VRAM. Licensed under Apache-2.0.</Run>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Install MOSS"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallMossDesignCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsMossDesignInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                            <ui:Button Content="Reinstall MOSS"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallMossDesignCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsMossDesignInstalled, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Voice Designer · VoxCPM2 (Scottish accents) -->
                <ui:CardExpander x:Name="VoxCpmDesignCard" Margin="0,0,0,4"
                                 Background="{StaticResource RetroCard}"
                                 BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Voice Designer · VoxCPM2 (Scottish accents)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Badge Appearance="Success" VerticalAlignment="Center"
                                      Visibility="{Binding IsVoxCpmDesignInstalled, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Installed" FontSize="11" />
                            </ui:Badge>
                            <ui:Badge Appearance="Caution" VerticalAlignment="Center"
                                      Visibility="{Binding IsVoxCpmDesignInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBlock Text="Not installed · optional" FontSize="11" />
                            </ui:Badge>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5">
                            <Run>A third voice designer: </Run>
                            <Hyperlink NavigateUri="https://huggingface.co/openbmb/VoxCPM2">VoxCPM2</Hyperlink>
                            <Run>. The best at Scottish accents in Yakkinator's accent test (it can't do Irish), with 48 kHz audio and 30 languages. Downloads PyTorch (~2.5 GB) and the model (~5 GB). Needs an NVIDIA GPU with ~8 GB free VRAM. Licensed under Apache-2.0.</Run>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Install VoxCPM2"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallVoxCpmDesignCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsVoxCpmDesignInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                            <ui:Button Content="Reinstall VoxCPM2"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding InstallVoxCpmDesignCommand}"
                                       Style="{StaticResource BounceButton}"
                                       IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                       Visibility="{Binding IsVoxCpmDesignInstalled, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>

            <ui:CardExpander Header="Setup Log"
                             Background="{StaticResource RetroCard}"
                             BorderBrush="{StaticResource RetroBorder}" BorderThickness="1.5">
                <TextBox Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="150"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </ui:CardExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
