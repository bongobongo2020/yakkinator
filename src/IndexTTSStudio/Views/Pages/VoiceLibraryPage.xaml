<Page x:Class="IndexTTSStudio.Views.Pages.VoiceLibraryPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           Title="Voice Library">

    <StackPanel Margin="32,16,32,32" MaxWidth="700" HorizontalAlignment="Left">
        <Grid Margin="0,0,0,20">
            <TextBlock Text="Voice Library" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ui:Button Content="Add Voice" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding AddVoiceCommand}"
                       HorizontalAlignment="Right" />
        </Grid>

        <TextBlock Text="Save reference voice samples for quick access." Opacity="0.6" Margin="0,0,0,16" />

        <ItemsControl ItemsSource="{Binding Voices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Opacity="0.5" FontSize="11">
                                    <Run Text="{Binding FileSize, StringFormat={}{0:N0} bytes}" />
                                    <Run Text=" | " />
                                    <Run Text="{Binding Modified, StringFormat={}{0:g}}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Icon="{ui:SymbolIcon Play24}"
                                           Command="{Binding DataContext.PreviewVoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Preview" Margin="0,0,4,0" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                                           Command="{Binding DataContext.DeleteVoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Delete" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
