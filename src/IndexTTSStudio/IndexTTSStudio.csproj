<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <RootNamespace>IndexTTSStudio</RootNamespace>
    <AssemblyName>Yakkinator</AssemblyName>
    <Product>Yakkinator</Product>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel hosts the remote API the Android app talks to (no admin URL ACLs, unlike HttpListener) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="NAudio" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\python\api_server.py" Link="python\api_server.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\python\indic_server.py" Link="python\indic_server.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\python\voicedesign_server.py" Link="python\voicedesign_server.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- A running copy locks Yakkinator.exe and the build can't overwrite it: close the one running
       from this output folder first (copies installed elsewhere are left alone). -->
  <Target Name="StopRunningApp" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\StopRunningApp.ps1&quot; -Dir &quot;$(TargetDir.TrimEnd('\'))&quot; -Name &quot;$(AssemblyName)&quot;"
          ContinueOnError="true" />
  </Target>
</Project>
